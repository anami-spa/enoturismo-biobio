---
/**
 * index.astro — Home de Enoturismo Biobío (prototipo).
 * Cada sección es HTML + Tailwind plano para migrar 1:1 a partials Blade de anami-cms.
 */
import { getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/home/Header.astro'
import Hero from '../components/home/Hero.astro'
import Explora from '../components/home/Explora.astro'
import Footer from '../components/home/Footer.astro'
import logo from '../assets/logo/logo-color.webp'
import { iniciativas } from '../utils/iniciativas'
import { abs, destino, organizacion, sitioWeb } from '../utils/schema'
import { url } from '../utils/url'

const origen = Astro.site!.origin
const logoUrl = abs((await getImage({ src: logo, width: 512, format: 'png' })).src, origen)
const jsonLd = [
  organizacion(origen, url(), logoUrl),
  sitioWeb(origen, url(), url('/explorar/')),
  destino(origen, url(), iniciativas.slice(0, 6).map((i) => ({ nombre: i.nombre, ruta: url(`/explorar/${i.slug}/`) }))),
]
---

<BaseLayout
  title="Enoturismo Biobío — Herencia viva"
  description="Descubre el enoturismo del Biobío: viñas, gastronomía, alojamiento y experiencias para conocer el sur de Chile a través de sus vinos, paisajes y personas."
  jsonLd={jsonLd}
  precargarFuentes={false}
>
  <Header />
  <main id="contenido-principal">
    <Hero />
    <Explora />
  </main>
  <Footer />
</BaseLayout>
