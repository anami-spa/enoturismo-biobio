---
/** Contacto. Prototipo: el formulario valida pero NO envía (sin backend). El envío real se implementa en anami-cms (Laravel). */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/home/Header.astro'
import Footer from '../../components/home/Footer.astro'
import { listado, migas } from '../../utils/schema'
import { url } from '../../utils/url'

const origen = Astro.site!.origin
const ruta = url('/contacto/')
const descripcion = 'Contacta al equipo de Enoturismo Biobío: registra tus dudas sobre el catálogo y las experiencias del territorio, o consulta cómo sumar tu iniciativa.'
const jsonLd = [
  listado(origen, 'ContactPage', 'Contacto — Enoturismo Biobío', descripcion, ruta),
  migas(origen, [{ nombre: 'Inicio', ruta: url() }, { nombre: 'Contacto', ruta }]),
]

const tipos = [
  { valor: 'informacion', texto: 'Información del catálogo' },
  { valor: 'sumar-iniciativa', texto: 'Quiero sumar mi iniciativa' },
  { valor: 'prensa', texto: 'Prensa / institucional' },
  { valor: 'otro', texto: 'Otro' },
]
const campo = 'mt-2 block min-h-12 w-full rounded-xl border border-white/60 bg-ciruela-oscuro px-4 text-lg text-white placeholder:text-white/60 aria-[invalid=true]:border-amarillo aria-[invalid=true]:border-2'
const etiqueta = 'block text-lg font-semibold tracking-wide'
const error = 'mt-1.5 hidden text-base font-semibold text-amarillo'
---

<BaseLayout title="Contacto — Enoturismo Biobío" description={descripcion} jsonLd={jsonLd}>
  <Header actual="contacto" solido />

  <main id="contenido-principal" class="bg-ciruela pb-20 pt-8 md:pb-28 md:pt-12">
    <div class="mx-auto max-w-[1440px] px-5 md:px-10 lg:px-24">
      <h1 class="text-[2.4rem] font-bold leading-tight md:text-5xl lg:text-[3.6rem]">¿Necesitas información?</h1>
      <p class="mt-3 text-xl font-light tracking-wide md:text-2xl">Registra tus dudas sobre el catálogo y las experiencias del territorio.</p>

      <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-8">
        <aside aria-labelledby="titulo-info" class="rounded-[1.6rem] lg:self-start bg-ciruela-oscuro p-8 md:p-10">
          <h2 id="titulo-info" class="text-lg font-bold uppercase tracking-[0.08em] text-amarillo">Información del programa</h2>
          <dl class="mt-8 space-y-7 text-xl font-light leading-snug md:text-2xl">
            <div><dt>Contacto oficial</dt><dd class="mt-1 text-white/85">[correo por confirmar]</dd></div>
            <div><dt>Equipo gestor / COPEVAL</dt><dd class="mt-1 text-white/85">[canal por confirmar]</dd></div>
          </dl>
          <p class="mt-10 rounded-xl bg-white/10 p-4 text-base leading-relaxed tracking-wide">
            ¿Quieres reservar o consultar por una viña, un alojamiento o un tour? Escribe directo a la iniciativa desde su ficha en
            <a href={url('/explorar/')} class="font-semibold underline underline-offset-4 hover:no-underline">Explorar</a>.
          </p>
        </aside>

        <section aria-labelledby="titulo-form" class="rounded-[1.6rem] bg-burdeos p-6 md:p-10">
          <h2 id="titulo-form" class="text-2xl font-bold md:text-3xl">Envíanos una consulta</h2>

          <div id="estado-envio" role="status" tabindex="-1" class="mt-5 hidden rounded-xl border-2 border-amarillo p-4 text-lg"></div>

          <form id="form-contacto" method="post" novalidate class="mt-6 space-y-5">
            <p class="text-base text-white/85">Los campos con <span class="font-bold text-amarillo" aria-hidden="true">*</span><span class="sr-only">asterisco</span> son obligatorios.</p>

            <div>
              <label for="nombre" class={etiqueta}>Nombre <span class="text-amarillo" aria-hidden="true">*</span></label>
              <input id="nombre" name="nombre" type="text" autocomplete="name" required maxlength="120" aria-describedby="err-nombre" class={campo} />
              <p id="err-nombre" class={error}></p>
            </div>

            <div>
              <label for="email" class={etiqueta}>Correo electrónico <span class="text-amarillo" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="err-email" class={campo} />
              <p id="err-email" class={error}></p>
            </div>

            <div>
              <label for="tipo" class={etiqueta}>Tipo de consulta <span class="text-amarillo" aria-hidden="true">*</span></label>
              <select id="tipo" name="tipo" required aria-describedby="err-tipo" class={campo}>
                <option value="">Selecciona una opción</option>
                {tipos.map((t) => <option value={t.valor}>{t.texto}</option>)}
              </select>
              <p id="err-tipo" class={error}></p>
            </div>

            <div>
              <label for="mensaje" class={etiqueta}>Mensaje <span class="text-amarillo" aria-hidden="true">*</span></label>
              <textarea id="mensaje" name="mensaje" rows="5" required maxlength="1000" aria-describedby="err-mensaje" class={`${campo} py-3`}></textarea>
              <p id="err-mensaje" class={error}></p>
            </div>

            <!-- Honeypot: invisible y fuera del orden de tabulación; un bot lo rellena, una persona no -->
            <div class="absolute -left-[9999px]" aria-hidden="true" inert>
              <label>No completar este campo<input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div>
              <div class="flex items-start gap-3">
                <input id="consentimiento" name="consentimiento" type="checkbox" required aria-describedby="err-consentimiento" class="mt-1 h-6 w-6 shrink-0 accent-amarillo" />
                <label for="consentimiento" class="text-base leading-snug tracking-wide">
                  Acepto que el equipo del programa use mis datos para responder mi consulta. Más información en la
                  <a href={url('/privacidad/')} class="font-semibold underline underline-offset-4 hover:no-underline">política de privacidad</a>.
                </label>
              </div>
              <p id="err-consentimiento" class={error}></p>
            </div>

            <noscript><p class="rounded-xl border-2 border-amarillo p-4 text-base">Para enviar la consulta se necesita JavaScript. Mientras tanto, escribe al contacto oficial indicado a la izquierda.</p></noscript>

            <div class="flex justify-end">
              <button type="submit" disabled class="inline-flex min-h-14 items-center gap-3 rounded-xl border border-white/40 bg-noche px-9 text-xl font-semibold tracking-wide hover:bg-noche/85 disabled:cursor-not-allowed disabled:opacity-60">
                Enviar consulta
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </button>
            </div>
          </form>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/contacto'
</script>
