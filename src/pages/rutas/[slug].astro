---
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/home/Header.astro'
import Footer from '../../components/home/Footer.astro'
import TarjetaIniciativa from '../../components/home/TarjetaIniciativa.astro'
import TarjetaArticulo from '../../components/rutas/TarjetaArticulo.astro'
import { articulos, fechaLarga, nombreTema, otrasHistorias } from '../../utils/articulos'
import type { Articulo } from '../../utils/articulos'
import { foto, iniciativas, nombreCategoria, nombreComuna } from '../../utils/iniciativas'
import { abs, articulo as schemaArticulo, migas } from '../../utils/schema'
import { url } from '../../utils/url'

export function getStaticPaths() {
  return articulos.map((a) => ({ params: { slug: a.slug }, props: { a } }))
}

const { a } = Astro.props as { a: Articulo }
const origen = Astro.site!.origin
const ruta = url(`/rutas/${a.slug}/`)
const tema = nombreTema(a.tema)
const relacionadas = a.iniciativas_relacionadas.map((s) => iniciativas.find((i) => i.slug === s)).filter((i): i is NonNullable<typeof i> => Boolean(i))
const og = await getImage({ src: foto(a.imagen), width: 1200, height: 630, fit: 'cover', format: 'jpg' })
const jsonLd = [
  schemaArticulo(origen, a, ruta, url(), abs(og.src, origen), relacionadas.map((i) => ({ nombre: i.nombre, ruta: url(`/explorar/${i.slug}/`) }))),
  migas(origen, [
    { nombre: 'Inicio', ruta: url() },
    { nombre: 'Rutas y experiencias', ruta: url('/rutas/') },
    { nombre: tema, ruta: url(`/rutas/tema/${a.tema}/`) },
    { nombre: a.titulo, ruta },
  ]),
]
---

<BaseLayout title={`${a.titulo} — ${tema} — Enoturismo Biobío`} description={a.extracto} ogImage={og.src} ogType="article" jsonLd={jsonLd}>
  <Header actual="rutas" solido />

  <main id="contenido-principal" class="bg-noche pb-20 pt-6 md:pb-28 md:pt-8">
    <div class="mx-auto max-w-[1440px] px-5 md:px-10 lg:px-24">
      <nav aria-label="Ruta de navegación" class="text-base tracking-wide md:text-lg">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href={url()} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Inicio</a></li>
          <li aria-hidden="true">›</li>
          <li><a href={url('/rutas/')} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Rutas y experiencias</a></li>
          <li aria-hidden="true">›</li>
          <li><a href={url(`/rutas/tema/${a.tema}/`)} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{tema}</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="font-semibold">{a.titulo}</li>
        </ol>
      </nav>

      <article class="mt-6">
        <div class="mx-auto max-w-[880px]">
        <header>
          <h1 class="text-[2.2rem] font-bold leading-tight tracking-[0.04em] md:text-5xl lg:text-[3.4rem]">{a.titulo}</h1>
          <p class="mt-3 text-lg tracking-wide text-white/85">{a.tipo} · {tema} · <time datetime={a.fecha}>{fechaLarga(a.fecha)}</time></p>
        </header>

        <!-- Foto principal (LCP): ancho acotado a la resolución real del insumo -->
        <Image src={foto(a.imagen)} alt={a.alt} width={880} height={587} widths={[480, 880]} sizes="(min-width: 960px) 880px, 100vw" loading="eager" fetchpriority="high" class="mt-8 aspect-[3/2] w-full rounded-[2.5rem] object-cover" />

        <div class="mt-10 max-w-[65ch] space-y-6 text-xl font-light leading-relaxed md:text-[1.35rem]">
          {a.cuerpo.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-10">
          <a href={url(a.cta.href)} class="inline-flex min-h-14 items-center gap-3 rounded-xl border border-white/40 bg-burdeos px-9 text-xl font-light tracking-[0.08em] hover:bg-burdeos/80">
            {a.cta.texto}
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
        </div>
        </div>
      </article>

      {relacionadas.length > 0 && (
        <section aria-labelledby="titulo-relacionadas" class="mt-20">
          <h2 id="titulo-relacionadas" class="text-3xl font-bold md:text-4xl">Iniciativas de esta historia</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relacionadas.map((i) => (
              <TarjetaIniciativa ancho="w-full" nombre={i.nombre} comuna={nombreComuna(i.comuna)} categoria={nombreCategoria(i.categoria)} imagen={foto(i.imagen)} href={url(`/explorar/${i.slug}/`)} />
            ))}
          </ul>
        </section>
      )}

      <section aria-labelledby="titulo-otras" class="mt-20">
        <h2 id="titulo-otras" class="text-3xl font-bold md:text-4xl">Otras historias</h2>
        <ul class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2">
          {otrasHistorias(a).map((o) => <TarjetaArticulo articulo={o} nivel={3} />)}
        </ul>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
