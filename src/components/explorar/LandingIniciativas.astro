---
/** Listado estático de iniciativas por comuna o por categoría: búsquedas orgánicas reales ("viñas en Yumbel"). Sin JS. */
import Header from '../home/Header.astro'
import Footer from './../home/Footer.astro'
import TarjetaIniciativa from '../home/TarjetaIniciativa.astro'
import { foto, nombreCategoria, nombreComuna } from '../../utils/iniciativas'
import type { Iniciativa } from '../../utils/iniciativas'
import { url } from '../../utils/url'

export interface Props {
  titulo: string
  intro: string
  items: Iniciativa[]
  /** Enlace al mismo filtro en Explorar (lista y mapa). */
  hrefExplorar: string
  /** Última miga: nombre de la página actual. */
  miga: string
}

const { titulo, intro, items, hrefExplorar, miga } = Astro.props
---

<Header actual="explorar" solido />

<main id="contenido-principal" class="bg-burdeos pb-20 pt-6 md:pt-8">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10 lg:px-24">
    <nav aria-label="Ruta de navegación" class="text-base tracking-wide md:text-lg">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href={url()} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Inicio</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={url('/explorar/')} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Explorar</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold">{miga}</li>
      </ol>
    </nav>

    <h1 class="mt-4 text-[2.2rem] font-bold leading-tight md:text-5xl lg:text-[3.4rem]">{titulo}</h1>
    <p class="mt-4 max-w-3xl text-xl font-light leading-relaxed">{intro}</p>
    <a href={hrefExplorar} class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-xl border border-white/40 bg-noche px-6 text-lg tracking-wide hover:bg-noche/85">Ver en el mapa y con filtros →</a>

    <h2 class="sr-only">Iniciativas</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((i, n) => (
        <TarjetaIniciativa prioritaria={n < 3} ancho="w-full" nombre={i.nombre} comuna={nombreComuna(i.comuna)} categoria={nombreCategoria(i.categoria)} imagen={foto(i.imagen)} href={url(`/explorar/${i.slug}/`)} />
      ))}
    </ul>
  </div>
</main>

<Footer />
