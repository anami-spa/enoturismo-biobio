---
import TarjetaIniciativa from '../../home/TarjetaIniciativa.astro'
import { cercanas, foto, nombreCategoria, nombreComuna } from '../../../utils/iniciativas'
import type { Iniciativa } from '../../../utils/iniciativas'
import { url } from '../../../utils/url'

export interface Props {
  iniciativa: Iniciativa
}

const { iniciativa } = Astro.props
const otras = cercanas(iniciativa)
---

{otras.length > 0 && (
  <section aria-labelledby="titulo-cercanos" class="mt-16">
    <h2 id="titulo-cercanos" class="text-2xl font-bold md:text-3xl">También en {nombreComuna(iniciativa.comuna)}</h2>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {otras.map((o) => (
        <TarjetaIniciativa ancho="w-full" nombre={o.nombre} comuna={nombreComuna(o.comuna)} categoria={nombreCategoria(o.categoria)} imagen={foto(o.imagen)} href={url(`/explorar/${o.slug}/`)} />
      ))}
    </ul>
  </section>
)}
