---
import { Image } from 'astro:assets'
import { foto } from '../../../utils/iniciativas'

export interface Props {
  nombre: string
  fotos: string[]
}

const { nombre, fotos } = Astro.props
const imagenes = fotos.map(foto)
---

<div id="galeria" data-galeria>
  <div class="overflow-hidden rounded-2xl bg-ciruela-oscuro">
    {imagenes.map((img, n) => (
      <Image
        src={img}
        alt={`${nombre}, foto ${n + 1} de ${imagenes.length}`}
        width={900}
        height={640}
        class="aspect-[4/3] w-full object-cover"
        loading={n === 0 ? 'eager' : 'lazy'}
        hidden={n !== 0}
        data-foto
      />
    ))}
  </div>
  {imagenes.length > 1 && (
    <ul class="mt-3 grid grid-cols-4 gap-3" aria-label="Fotos de la galería">
      {imagenes.map((img, n) => (
        <li>
          <button type="button" data-miniatura={n} aria-label={`Ver foto ${n + 1}`} aria-pressed={n === 0 ? 'true' : 'false'} class="block w-full overflow-hidden rounded-xl opacity-70 aria-pressed:opacity-100 aria-pressed:ring-4 aria-pressed:ring-amarillo hover:opacity-100">
            <Image src={img} alt="" width={200} height={150} class="aspect-[4/3] w-full object-cover" loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  // Miniaturas: cambian la foto principal. Sin JS se ve solo la primera.
  const galeria = document.querySelector<HTMLElement>('[data-galeria]')
  const fotos = galeria?.querySelectorAll<HTMLElement>('[data-foto]')
  const minis = galeria?.querySelectorAll<HTMLButtonElement>('[data-miniatura]')
  minis?.forEach((m) =>
    m.addEventListener('click', () => {
      const n = Number(m.dataset.miniatura)
      fotos?.forEach((f, i) => (f.hidden = i !== n))
      minis.forEach((b, i) => b.setAttribute('aria-pressed', String(i === n)))
    }),
  )
</script>
