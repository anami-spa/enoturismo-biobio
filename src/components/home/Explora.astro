---
import HojaTransicion from './HojaTransicion.astro'
import TarjetaIniciativa from './TarjetaIniciativa.astro'
import datos from '../../data/iniciativas.json'
import { url } from '../../utils/url'

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/fotos/*.webp', { eager: true })
const foto = (nombre: string) => fotos[`../../assets/fotos/${nombre}.webp`].default
---

<section id="explorar" class="relative overflow-x-clip bg-ciruela pb-6 pt-20 md:pt-28" aria-labelledby="titulo-explora">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10 lg:px-24">
    <h2 id="titulo-explora" class="text-[2.4rem] font-bold leading-[1.02] text-white md:text-[3.1rem] lg:text-[5rem] lg:leading-[0.98]">
      Explora las historias<br class="hidden md:block" /> que hacen vivo el territorio
    </h2>
    <p class="mt-8 text-base tracking-[0.1em] text-white md:text-[1.35rem]">
      {datos.total_registradas} iniciativas registradas en el listado actual
    </p>
  </div>

  <div class="relative mt-12 md:mt-20">
    <ul id="carrusel" class="carrusel flex gap-5 overflow-x-auto px-5 pb-4 md:px-10 lg:px-6" tabindex="0" aria-label="Iniciativas destacadas">
      {datos.iniciativas.map((i) => (
        <TarjetaIniciativa nombre={i.nombre} comuna={i.comuna} categoria={i.categoria} imagen={foto(i.imagen)} href={url(`/explorar/#${i.slug}`)} />
      ))}
    </ul>
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-28 bg-gradient-to-l from-ciruela to-transparent md:block" aria-hidden="true"></div>
    <button id="carrusel-sig" type="button" aria-label="Ver siguientes iniciativas" class="absolute right-3 top-1/2 hidden h-12 w-12 -translate-y-1/2 place-items-center rounded-full text-white hover:bg-white/15 md:grid">
      <svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
    </button>
  </div>

  <div class="mx-auto flex max-w-[1440px] flex-col items-start gap-6 px-5 pb-24 pt-16 lg:flex-row lg:items-center lg:gap-12 md:px-10 md:pt-[4.4rem] lg:px-24">
    <p class="text-[1.7rem] font-bold text-white md:text-[2.4rem] lg:text-5xl">¿Prefieres buscar en el mapa?</p>
    <a href={url('/explorar/')} class="inline-flex min-h-14 items-center gap-3 whitespace-nowrap rounded-xl bg-noche px-9 py-4 text-xl font-light tracking-[0.08em] md:px-14 md:py-7 md:text-[1.9rem] text-white hover:bg-noche/85">
      Ver mapa y filtros
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
  </div>

  <HojaTransicion />
</section>

<script>
  // Flecha del carrusel: desplaza una tarjeta. Sin dependencias.
  const lista = document.getElementById('carrusel')
  const sig = document.getElementById('carrusel-sig')
  sig?.addEventListener('click', () => {
    const paso = (lista?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 360
    lista?.scrollBy({ left: paso + 20, behavior: 'smooth' })
  })
</script>
